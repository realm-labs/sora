tables = {
  Quest = {
    mode = "map"
    key = "id"
    source = {
      file = "Quest.xlsx"
      sheet = "Quest"
    }
    fields = {
      id = "i32"
      quest_type = "enum<QuestType>"
      title = {
        type = "string"
        length = [
          4,
          64,
        ]
      }
      required_item = "ref<Item.id>"
      unlock_skills = {
        type = "list<ref<Skill.id>>"
        length = [
          1,
          3,
        ]
        parser = "json"
      }
      start_pos = {
        type = "struct<Vec3>"
        parser = "tuple"
      }
      rewards = {
        type = "list<Reward>"
        comment = "Materialized from QuestReward child rows"
        from = {
          table = "QuestReward"
          parent_key = "id"
          child_key = "quest_id"
          order_by = "seq"
        }
      }
    }
  }
  QuestReward = {
    mode = "list"
    source = {
      file = "Quest.xlsx"
      sheet = "QuestReward"
    }
    fields = {
      quest_id = "ref<Quest.id>"
      seq = "i32"
      item_id = "ref<Item.id>"
      count = {
        type = "i32"
        range = [
          1,
          9999,
        ]
      }
    }
  }
  LevelExp = {
    mode = "map"
    key = "level"
    source = {
      file = "Core.xlsx"
      sheet = "LevelExp"
    }
    fields = {
      level = {
        type = "i32"
        range = [
          1,
          100,
        ]
      }
      exp = {
        type = "i64"
        range = [
          0,
          999999999,
        ]
      }
      unlock_feature = "optional<string>"
    }
  }
  Achievement = {
    mode = "map"
    key = "id"
    source = {
      file = "Economy.xlsx"
      sheet = "Achievement"
    }
    fields = {
      id = "i32"
      title_key = "text"
      target_count = "i64"
      reward = {
        type = "struct<ResourceCost>"
        parser = "tuple"
      }
    }
  }
  VipLevel = {
    mode = "map"
    key = "level"
    source = {
      file = "Economy.xlsx"
      sheet = "VipLevel"
    }
    fields = {
      level = "i32"
      cost = {
        type = "struct<ResourceCost>"
        parser = "tuple"
      }
      perks = {
        type = "list<string>"
        length = [
          1,
          5,
        ]
        parser = "json"
      }
    }
  }
}
